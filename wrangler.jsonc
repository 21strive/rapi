{
  // rapi.21strive.com: the Rapi docs, served as static assets by a Cloudflare Worker.
  // Build first (npm run build), then deploy with ./scripts/deploy.sh or `npx wrangler@4 deploy`.
  // The custom domain needs the 21strive.com zone in the same Cloudflare account.
  "name": "rapi-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [{ "pattern": "rapi.21strive.com", "custom_domain": true }],
  // Only the custom domain serves the site: no workers.dev URL, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // The 21 Strive Cloudflare account, pinned so a login that sees several accounts never deploys elsewhere.
  "account_id": "3575e13cd5c74a5f07b96789b7c400a5"
}
